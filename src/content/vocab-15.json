      "seine",
      "ihre"
    ],
    "alt": [
      "si",
      "sitt",
      "sine"
    ],
    "pos": "pron",
    "lesson": 15,
    "note": "sin (en-Wort), si (ei-Wort), sitt (et-Wort), sine (Plural) – nur wenn der Besitzer das Subjekt desselben Satzes ist (3. Person).",
